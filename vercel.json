{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/kesan&pesan", "destination": "/kesan.html" }
  ],
  "redirects": [
    { "source": "/admin.html", "destination": "/admin", "statusCode": 308 },
    { "source": "/kesan", "destination": "/kesan&pesan", "statusCode": 308 },
    { "source": "/kesan.html", "destination": "/kesan&pesan", "statusCode": 308 }
  ]
}
